include CONTRIBUTING.md THIRD_PARTY.md
include mrbench.example.toml .env.example .python-version uv.lock
recursive-include docs *.md *.png *.jpg
recursive-include examples *.json
recursive-include tests *.py *.json
recursive-include tools *.py
recursive-include skills *.md *.yaml

prune .local
prune .cache
prune runs
prune notes
prune logs
global-exclude *.log *.log.*
