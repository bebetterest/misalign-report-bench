{
  "schema_version": 2,
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "index_url": "https://alignment.openai.com/misalignment-reports/",
      "snapshot": "sources/openai.json",
      "discovery": {
        "adapter": "html",
        "allowed_hosts": [
          "deploymentsafety.openai.com",
          "openai.com"
        ],
        "article_selector": "main",
        "entries": [
          {
            "selector": "table:not(.notice-table) > tbody.report-entry",
            "url_selector": ".entry-main a.report-title",
            "title_selector": ".entry-main a.report-title",
            "date_selector": "td[data-label=\"Last updated\"] time",
            "kind": "report",
            "date_basis": "report_updated"
          },
          {
            "selector": "table.notice-table > tbody.report-entry",
            "url_selector": ".entry-main a.report-title",
            "title_selector": ".entry-main a.report-title",
            "date_selector": "td[data-label=\"First posted\"] time",
            "kind": "notice",
            "identity": "url-title",
            "date_basis": "index_first_posted"
          }
        ]
      }
    },
    {
      "id": "transluce",
      "name": "Transluce",
      "index_url": "https://transluce.org/investigations",
      "snapshot": "sources/transluce.json",
      "discovery": {
        "adapter": "html",
        "article_selector": "main",
        "entries": [
          {
            "selector": "main section article:has(.text-darkluce:-soup-contains-own(\"Incident Investigations\")):has(a[href^=\"/investigations/blog/\"])",
            "url_selector": "h3 a",
            "title_selector": "h3 a",
            "date_selector": "p.text-meta > span.whitespace-nowrap",
            "kind": "blog",
            "date_basis": "published",
            "date_formats": [
              "%b %d, %Y"
            ]
          },
          {
            "selector": "main section article:has(.text-darkluce:-soup-contains-own(\"Incident Investigations\")):not(:has(a[href^=\"/investigations/blog/\"]))",
            "url_selector": "h3 a",
            "title_selector": "h3 a",
            "date_selector": "p.text-meta > span.whitespace-nowrap",
            "kind": "report",
            "date_basis": "published",
            "date_formats": [
              "%b %d, %Y"
            ]
          }
        ]
      }
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "index_url": "https://www.anthropic.com/research",
      "snapshot": "sources/anthropic.json",
      "discovery": {
        "adapter": "reviewed",
        "article_selector": "main, d-article",
        "allowed_hosts": [
          "www.anthropic.com",
          "assets.claude.com",
          "www-cdn.anthropic.com",
          "alignment.anthropic.com"
        ],
        "max_bytes": 67108864
      }
    }
  ],
  "catalogs": [
    {
      "id": "alignment-hub",
      "name": "Alignment Hub",
      "index_url": "https://huggingface.co/spaces/witness-archive/alignment-hub",
      "snapshot": "source-catalogs/alignment-hub.json",
      "adapter": "jsonl",
      "revision_url": "https://huggingface.co/api/datasets/witness-archive/alignment-hub",
      "data_url": "https://huggingface.co/datasets/witness-archive/alignment-hub/raw/{revision}/data/incidents.jsonl",
      "allowed_hosts": [
        "huggingface.co"
      ],
      "fields": {
        "id": "id",
        "title": "title",
        "url": "source_url",
        "updated": "sources_checked_on",
        "publisher": "reporter",
        "developers": "developers",
        "evidence_context": "evidence_context",
        "parent_incident_id": "parent_incident_id",
        "upstream_review_status": "review_status",
        "strength": "strength"
      }
    }
  ]
}
