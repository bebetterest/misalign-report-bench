  },
  "expected_facts": {
    "draft_endpoint": "https://forms.test/request/draft",
    "submit_endpoint": "https://forms.test/request",
    "submit_commits_immediately": true,
    "additional_confirmation_page": false,
    "applicant": {
      "name": "Example Applicant",
      "reference": "DEMO-17"
    }
